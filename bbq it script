-- == Core Helper Functions ==

local function getCookingSpots(furniture)
    local exactMatches = {"GrillSpots", "OvenSpots", "RitualSpots", "AlienSpots", "CookingSpots", "Spots"}
    for _, name in ipairs(exactMatches) do
        local found = furniture:FindFirstChild(name)
        if found then return found end
    end
    for _, child in ipairs(furniture:GetChildren()) do
        local lowerName = string.lower(child.Name)
        if string.find(lowerName, "spot") and not string.find(lowerName, "plate") then
            return child
        end
    end
    return nil
end

local function getActualSpotPart(spot)
    if spot:IsA("BasePart") or spot:IsA("UnionOperation") then return spot end
    local part = spot:FindFirstChildWhichIsA("BasePart") or spot:FindFirstChildWhichIsA("UnionOperation")
    if part then return part end
    return spot
end

local function isSpotEmpty(spot)
    for _, desc in ipairs(spot:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            local text = string.lower(desc.ActionText)
            if string.find(text, "pick") or string.find(text, "take") then return false end
        end
    end
    if spot:GetAttribute("MeatName") ~= nil then return false end
    for _, child in ipairs(spot:GetChildren()) do
        if child:GetAttribute("MeatName") ~= nil then return false end
        if child:FindFirstChild("CookBillboard") or child.Name == "CookBillboard" then return false end
    end
    return true
end

local lastEquipTime = 0

local function getAndEquipMeat(typeFilter)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local backpack = player:FindFirstChild("Backpack")
    if not hum or not backpack then return nil end

    local function isCorrectMeat(tool)
        if not tool:IsA("Tool") then return false end
        local name = string.lower(tool.Name)
        
        if string.find(name, "hammer") or string.find(name, "table") or string.find(name, "chair") or string.find(name, "oven") or string.find(name, "tent") or string.find(name, "ritual") then return false end
        if string.find(name, "grill") and not string.find(name, "grilled") then return false end
        
        local isCooked = string.find(name, "%[") or string.find(name, "perfect") or string.find(name, "overcooked") or string.find(name, "cooked")
        local isRaw = string.find(name, "raw ")
        
        if typeFilter == "Raw" and isRaw and not isCooked then return true
        elseif typeFilter == "Cooked" and isCooked then return true end
        return false
    end

    local holdingMeat = nil
    for _, t in ipairs(char:GetChildren()) do 
        if isCorrectMeat(t) then 
            holdingMeat = t 
            break 
        end 
    end

    if holdingMeat then
        if tick() - lastEquipTime < 3 then
            return holdingMeat
        else
            hum:UnequipTools()
            task.wait(0.1)
        end
    end

    local validMeats = {}
    for _, t in ipairs(backpack:GetChildren()) do 
        if isCorrectMeat(t) then table.insert(validMeats, t) end 
    end

    if #validMeats > 0 then
        local chosenMeat = validMeats[math.random(1, #validMeats)]
        hum:EquipTool(chosenMeat)
        lastEquipTime = tick()
        task.wait(0.15) 
        return chosenMeat
    end
    
    return nil
end

local function countMeatStock(targetName)
    local count = 0
    local tLower = string.lower(targetName)
    local function scan(folder)
        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Tool") and string.find(string.lower(item.Name), tLower) then
                local match = string.match(item.Name, "%(x(%d+)%)")
                if match then count = count + tonumber(match) else count = count + 1 end
            end
        end
    end
    if player.Character then scan(player.Character) end
    if player:FindFirstChild("Backpack") then scan(player:FindFirstChild("Backpack")) end
    return count
end

local function getCleanName(toolName)
    local clean = string.gsub(toolName, "%s*%(x%d+%)", "")
    return string.match(clean, "^%s*(.-)%s*$") or clean
end

-- == Main Automation Loop (ACTION QUEUE SYSTEM) ==
task.spawn(function()
    while task.wait(ActionDelay) do
        local myLot = workspace:WaitForChild("PlayerLots"):FindFirstChild(player.Name)
        if not myLot then continue end
        
        local actionTakenThisTick = false
        
        -- PRIORITY 1: Pick up Perfect Meats 
        if Toggles.AutoCook then
            for _, furniture in ipairs(myLot:GetChildren()) do
                local grills = getCookingSpots(furniture)
                if grills then
                    for _, spot in ipairs(grills:GetChildren()) do
                        local state = MeatStates[spot]
                        if not state then
                            local bb = spot:FindFirstChild("CookBillboard", true)
                            if bb and bb:FindFirstChild("BG") and bb.BG:FindFirstChild("StateLabel") then state = bb.BG.StateLabel.Text end
                        end
                        if state == "Perfect" then
                            ReplicatedStorage.Remotes.PickupMeat:FireServer(getActualSpotPart(spot))
                            MeatStates[spot] = nil
                            actionTakenThisTick = true
                            task.wait(0.2)
                        end
                    end
                end
            end
        end
        
        if actionTakenThisTick then continue end 
        
        -- PRIORITY 2: Place Raw Meat on Appliances
        if Toggles.AutoCook then
            for _, furniture in ipairs(myLot:GetChildren()) do
                local grills = getCookingSpots(furniture)
                if grills then
                    for _, spot in ipairs(grills:GetChildren()) do
                        if isSpotEmpty(spot) then
                            local rawMeat = getAndEquipMeat("Raw")
                            if rawMeat then
                                ReplicatedStorage.Remotes.PlaceMeat:FireServer(getActualSpotPart(spot), getCleanName(rawMeat.Name))
                                actionTakenThisTick = true
                                task.wait(0.3) 
                                break 
                            end
                        end
                    end
                end
                if actionTakenThisTick then break end
            end
        end
        
        if actionTakenThisTick then continue end 
        
        -- PRIORITY 3: Place Cooked Meat on Plates
        if Toggles.AutoPlate then
            for _, furniture in ipairs(myLot:GetChildren()) do
                local plates = furniture:FindFirstChild("Plates")
                if plates then
                    for _, plate in ipairs(plates:GetChildren()) do
                        if isSpotEmpty(plate) then
                            local cookedMeat = getAndEquipMeat("Cooked")
                            if cookedMeat then
                                ReplicatedStorage.Remotes.PlaceMeat:FireServer(getActualSpotPart(plate), getCleanName(cookedMeat.Name))
                                actionTakenThisTick = true
                                task.wait(0.3)
                                break 
                            end
                        end
                    end
                end
                if actionTakenThisTick then break end
            end
        end
    end
end)

-- == Auto Buy Loop (FIXED REMOTES) ==
task.spawn(function()
    while task.wait(1.5) do
        if Toggles.AutoBuy and #BuyTargets > 0 then
            for _, targetMeat in ipairs(BuyTargets) do
