                    task.wait(0.3)
                end
            end
        end
        if Toggles.AutoBuyTotem and #BuyTotemTargets > 0 then
            for _, targetTotem in ipairs(BuyTotemTargets) do
                if countMeatStock(targetTotem) < BuyThreshold then
                    -- 🛠️ FIX: Totems strictly use BuyShopItem remote
                    if ReplicatedStorage.Remotes:FindFirstChild("BuyShopItem") then
                        ReplicatedStorage.Remotes.BuyShopItem:FireServer(targetTotem, false)
                    end
                    task.wait(0.3)
                end
            end
        end
    end
end)

